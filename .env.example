# Скопируйте в .env рядом с docker-compose.yml. Пароли RabbitMQ и Redis и
# файлы ключей в ./secrets создаёт scripts/make-secrets.sh — в git они не идут.

# --- Вход в систему (ТЗ 12) ---
# Первый администратор создаётся при первом запуске: admin / admin на время
# проверки. В промышленном контуре задайте свой пароль.
INSPECTOR_ADMIN_LOGIN=admin
# INSPECTOR_ADMIN_PASSWORD=
# Cookie сессии в основном составе всегда передаётся только по HTTPS.

# --- Модель ИИ: только локальная, внутри контура ---
INSPECTOR_LOCAL_LLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# Каталог весов внутри ./models.
INSPECTOR_MODEL_DIR=Qwen2.5-VL-7B-Instruct
# Доля памяти GPU для vLLM. GPU стенда может быть общим для нескольких
# команд: vLLM резервирует долю от всей памяти карты, поэтому задавайте
# её под свободный объём (7B-модели достаточно 0.5 от 80 ГБ).
INSPECTOR_LLM_GPU_MEMORY=0.85
# Номер GPU на хосте.
# INSPECTOR_GPU=0
# Окно контекста модели, токенов.
# INSPECTOR_LLM_MAX_MODEL_LEN=32768
# Одновременных вызовов модели от одного воркера: vLLM сам собирает их в пакеты.
INSPECTOR_LLM_CONCURRENCY=8
# Реплик ML-воркера: одна задача разбора или проверки на реплику.
INSPECTOR_ML_WORKERS=4
# Внутренние имена с точкой, которые тоже считаются контуром (через запятую).
# INSPECTOR_ALLOWED_HOSTS=

# --- Распознавание сканов: Tesseract в образе ---
INSPECTOR_OCR_LANGUAGE=rus+eng

# --- Обработка (ТЗ 9.1) ---
# Срок задачи разбора и проверки, секунд: по истечении — повтор (не более
# двух), затем уведомление администратора.
# INSPECTOR_PARSE_TIMEOUT_S=900
# INSPECTOR_INSPECT_TIMEOUT_S=3600
# Версия набора данных, записываемая в протокол.
# INSPECTOR_DATASET_VERSION=none

# --- Передача результатов в ИАИС «РиН» (ТЗ 9.6) ---
# Пусто — передача выключена: пакет формируется, статус LOCAL_ONLY.
# Адрес должен быть внутри контура, соединение — TLS 1.3 с клиентским сертификатом.
# INSPECTOR_RIN_URL=https://rin-gateway.local/inbox
# INSPECTOR_RIN_CLIENT_CERT=/certs/client.pem
# INSPECTOR_RIN_CLIENT_KEY=/certs/client.key
# INSPECTOR_RIN_CA=/certs/rin-ca.pem
# Токен приёмника (если нужен) — файлом secrets/rin.token.

# --- Создаётся scripts/make-secrets.sh ---
# INSPECTOR_AMQP_PASSWORD=
# INSPECTOR_REDIS_PASSWORD=

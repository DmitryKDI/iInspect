    "ioredis": "^6.0.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "undici": "^8.11.2"
  },
  "devDependencies": {

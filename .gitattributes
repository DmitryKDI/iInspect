# Windows-ярлык обязан иметь CRLF: cmd.exe спотыкается на метках и goto
# в файле с юниксовыми переводами строк.
*.bat text eol=crlf

# Обратная причина того же рода: эти скрипты выполняются внутри WSL/bash,
# который ломается на CRLF (символ \r попадает в последний аргумент строки,
# например `cd: $'./scripts/..\r': No such file or directory`). На машине
# с git core.autocrlf=true без этого правила чекаут молча портит скрипты.
*.sh text eol=lf
